// Glideinbir Kart — Prisma schema (PostgreSQL)
// Money is always Decimal(12,2) in INR. Soft deletes use `deletedAt`.
// Full-text search (tsvector + GIN) and pg_trgm indexes live in the raw SQL migration `*_search_and_constraints`.

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x = the Linux runtime Vercel functions run on
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_VERIFY
}

enum SellerStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum KycDocType {
  PAN
  GSTIN_CERTIFICATE
  BANK_PROOF
  ID_PROOF
  ADDRESS_PROOF
  OTHER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  COLOR
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum SubOrderStatus {
  PENDING
  ACCEPTED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ESCALATED
  PICKED_UP
  RECEIVED
  REFUNDED
  CLOSED
}

enum CouponType {
  FLAT
  PERCENTAGE
}

enum PayoutStatus {
  PENDING
  SETTLED
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  SELLER
}

enum NotificationType {
  ORDER
  PAYMENT
  PROMO
  SELLER
  PRODUCT
  REVIEW
  QNA
  SYSTEM
}

enum BannerPlacement {
  HERO
  SECONDARY
  STRIP
}

enum ModerationStatus {
  VISIBLE
  HIDDEN
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  name            String
  avatarUrl       String?
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  blockedReason   String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  /// Bumped on logout-all / password change / block so older access tokens stop working immediately.
  tokenVersion    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  refreshTokens  RefreshToken[]
  otpCodes       OtpCode[]
  addresses      Address[]
  sellerProfile  SellerProfile?
  cart           Cart?
  wishlist       WishlistItem[]
  recentlyViewed RecentlyViewed[]
  orders         Order[]
  reviews        Review[]
  questions      Question[]
  answers        Answer[]
  notifications  Notification[]
  pushTokens     PushToken[]
  couponUsages   CouponUsage[]
  returnRequests ReturnRequest[]
  auditLogs      AuditLog[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  clientType   String    @default("web")
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String?
  identifier String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@index([userId])
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String      @default("India")
  type      AddressType @default(HOME)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pincode])
}

// ───────────────────────────── Sellers ─────────────────────────────

model SellerProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  storeName         String
  slug              String       @unique
  description       String?
  logoUrl           String?
  businessName      String?
  businessType      String?
  gstin             String?
  pan               String?
  contactEmail      String?
  contactPhone      String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  pickupLine1       String?
  pickupLine2       String?
  pickupCity        String?
  pickupState       String?
  pickupPincode     String?
  status            SellerStatus @default(DRAFT)
  onboardingStep    Int          @default(0)
  adminRemarks      String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  ratingAvg         Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount       Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycDocuments    SellerKyc[]
  products        Product[]
  subOrders       SubOrder[]
  payouts         Payout[]
  commissionRules CommissionRule[]

  @@index([status])
  @@index([createdAt])
}

model SellerKyc {
  id           String     @id @default(cuid())
  sellerId     String
  docType      KycDocType
  fileUrl      String
  fileName     String?
  status       KycStatus  @default(PENDING)
  remarks      String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  parentId    String?
  /// Slash-joined slug path, e.g. "electronics/mobiles/smartphones"
  path        String
  depth       Int       @default(0)
  description String?
  imageUrl    String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryTree")
  products           Product[]
  categoryAttributes CategoryAttribute[]
  commissionRules    CommissionRule[]

  @@index([parentId])
  @@index([path])
  @@index([isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Category_name_trgm_idx")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@index([isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Brand_name_trgm_idx")
}

model Attribute {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  type         AttributeType @default(SELECT)
  unit         String?
  isFilterable Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  values             AttributeValue[]
  categoryAttributes CategoryAttribute[]
}

model AttributeValue {
  id          String  @id @default(cuid())
  attributeId String
  value       String
  hex         String?
  sortOrder   Int     @default(0)

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
  @@index([attributeId])
}

model CategoryAttribute {
  categoryId    String
  attributeId   String
  isRequired    Boolean @default(false)
  /// true → the attribute defines SKU variants (size, colour); false → descriptive spec only
  isVariantAxis Boolean @default(false)
  sortOrder     Int     @default(0)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
}

model Product {
  id               String        @id @default(cuid())
  sellerId         String
  categoryId       String
  brandId          String?
  name             String
  slug             String        @unique
  description      String        @db.Text
  highlights       String[]
  specifications   Json          @default("[]")
  attributes       Json          @default("{}")
  tags             String[]
  status           ProductStatus @default(DRAFT)
  rejectionReason  String?
  gstRate          Decimal       @default(18) @db.Decimal(5, 2)
  hsnCode          String?
  /// Denormalised from active variants for fast listing, filtering and sorting.
  minPrice         Decimal       @default(0) @db.Decimal(12, 2)
  maxPrice         Decimal       @default(0) @db.Decimal(12, 2)
  minMrp           Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent  Int           @default(0)
  totalStock       Int           @default(0)
  ratingAvg        Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  viewCount        Int           @default(0)
  isReturnable     Boolean       @default(true)
  returnWindowDays Int           @default(7)
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  /// Maintained by trigger + search-index worker; GIN indexed in raw SQL migration.
  searchVector Unsupported("tsvector")?

  seller         SellerProfile    @relation(fields: [sellerId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  brand          Brand?           @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  wishlistItems  WishlistItem[]
  recentlyViewed RecentlyViewed[]
  reviews        Review[]
  questions      Question[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@index([minPrice])
  @@index([soldCount])
  @@index([ratingAvg])
  @@index([searchVector], type: Gin, map: "Product_searchVector_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

model ProductVariant {
  id          String    @id @default(cuid())
  productId   String
  sku         String    @unique
  name        String
  attributes  Json      @default("{}")
  mrp         Decimal   @db.Decimal(12, 2)
  price       Decimal   @db.Decimal(12, 2)
  weightGrams Int?
  barcode     String?
  position    Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([price])
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "ProductVariant_attributes_idx")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  publicId  String?
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
}

model Inventory {
  id                String   @id @default(cuid())
  variantId         String   @unique
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Cart & wishlist ─────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String   @unique
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  variantId     String
  quantity      Int
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ───────────────────────────── Orders & payments ─────────────────────────────

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod
  /// Immutable copy of the shipping address at purchase time.
  shippingAddress Json
  couponId        String?
  couponCode      String?
  mrpTotal        Decimal       @db.Decimal(12, 2)
  productDiscount Decimal       @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)
  couponDiscount  Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(12, 2)
  /// GST *included* in the total (prices are GST-inclusive in India).
  gstTotal        Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  notes           String?
  invoiceNumber   String?       @unique
  invoiceUrl      String?
  /// Stock reservation / payment window for online payments.
  expiresAt       DateTime?
  placedAt        DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  user          User                 @relation(fields: [userId], references: [id])
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  subOrders     SubOrder[]
  items         OrderItem[]
  payments      Payment[]
  refunds       Refund[]
  statusHistory OrderStatusHistory[]
  couponUsages  CouponUsage[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model SubOrder {
  id               String         @id @default(cuid())
  orderId          String
  sellerId         String
  subOrderNumber   String         @unique
  status           SubOrderStatus @default(PENDING)
  subtotal         Decimal        @db.Decimal(12, 2)
  discount         Decimal        @default(0) @db.Decimal(12, 2)
  gstTotal         Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  commissionRate   Decimal        @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal        @default(0) @db.Decimal(12, 2)
  sellerEarning    Decimal        @default(0) @db.Decimal(12, 2)
  courier          String?
  trackingId       String?
  trackingUrl      String?
  acceptedAt       DateTime?
  packedAt         DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  payoutId         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller         SellerProfile        @relation(fields: [sellerId], references: [id])
  payout         Payout?              @relation(fields: [payoutId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([sellerId, status])
  @@index([payoutId])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  subOrderId  String
  sellerId    String
  productId   String
  variantId   String
  name        String
  variantName String?
  sku         String
  slug        String
  image       String?
  quantity    Int
  mrp         Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  /// Share of the coupon discount allocated to this line.
  discount    Decimal @default(0) @db.Decimal(12, 2)
  gstRate     Decimal @db.Decimal(5, 2)
  gstAmount   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  returnedQty Int     @default(0)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder       SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  returnRequests ReturnRequest[]
  review         Review?

  @@index([orderId])
  @@index([subOrderId])
  @@index([productId])
  @@index([sellerId])
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  subOrderId String?
  status     String
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder SubOrder? @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([subOrderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  signature         String?
  failureReason     String?
  paidAt            DateTime?
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

/// Idempotency ledger for payment-provider webhooks.
model WebhookEvent {
  id          String   @id
  provider    String
  type        String
  payload     Json?
  processedAt DateTime @default(now())

  @@index([provider, type])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String?
  orderId          String
  returnRequestId  String?      @unique
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  reason           String?
  notes            String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment       Payment?       @relation(fields: [paymentId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([orderId])
  @@index([status])
}

model ReturnRequest {
  id            String       @id @default(cuid())
  orderItemId   String
  subOrderId    String
  userId        String
  quantity      Int          @default(1)
  reason        String
  description   String?
  images        String[]
  status        ReturnStatus @default(REQUESTED)
  sellerRemarks String?
  adminRemarks  String?
  refundAmount  Decimal?     @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  subOrder  SubOrder  @relation(fields: [subOrderId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  refund    Refund?

  @@index([orderItemId])
  @@index([subOrderId])
  @@index([userId])
  @@index([status])
}

// ───────────────────────────── Promotions ─────────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType
  value          Decimal    @db.Decimal(12, 2)
  minOrderAmount Decimal    @default(0) @db.Decimal(12, 2)
  maxDiscount    Decimal?   @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int        @default(0)
  perUserLimit   Int        @default(1)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  usages CouponUsage[]
  orders Order[]

  @@index([isActive, expiresAt])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
}

model Banner {
  id             String          @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  ctaText        String?
  bgColor        String?
  placement      BannerPlacement @default(HERO)
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

// ───────────────────────────── Social ─────────────────────────────

model Review {
  id                 String           @id @default(cuid())
  productId          String
  userId             String
  orderItemId        String?          @unique
  rating             Int
  title              String?
  body               String?          @db.Text
  isVerifiedPurchase Boolean          @default(false)
  helpfulCount       Int              @default(0)
  status             ModerationStatus @default(VISIBLE)
  sellerReply        String?
  sellerRepliedAt    DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])
  orderItem OrderItem?    @relation(fields: [orderItemId], references: [id])
  images    ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([rating])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Question {
  id        String           @id @default(cuid())
  productId String
  userId    String
  body      String
  status    ModerationStatus @default(VISIBLE)
  createdAt DateTime         @default(now())
  deletedAt DateTime?

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  answers Answer[]

  @@index([productId, createdAt])
}

model Answer {
  id         String    @id @default(cuid())
  questionId String
  userId     String
  body       String
  isSeller   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([questionId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("expo")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Finance ─────────────────────────────

model Payout {
  id               String       @id @default(cuid())
  sellerId         String
  periodStart      DateTime
  periodEnd        DateTime
  grossAmount      Decimal      @db.Decimal(12, 2)
  commissionAmount Decimal      @db.Decimal(12, 2)
  netAmount        Decimal      @db.Decimal(12, 2)
  status           PayoutStatus @default(PENDING)
  reference        String?
  notes            String?
  settledAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  seller    SellerProfile @relation(fields: [sellerId], references: [id])
  subOrders SubOrder[]

  @@index([sellerId, status])
  @@index([createdAt])
}

model CommissionRule {
  id         String          @id @default(cuid())
  scope      CommissionScope
  categoryId String?
  sellerId   String?
  /// Percentage, e.g. 8.50
  rate       Decimal         @db.Decimal(5, 2)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  seller   SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
  @@index([categoryId])
  @@index([sellerId])
}

// ───────────────────────────── Platform ─────────────────────────────

model ServiceablePincode {
  id           String  @id @default(cuid())
  pincode      String  @unique
  city         String
  state        String
  deliveryDays Int     @default(4)
  codAvailable Boolean @default(true)
  isActive     Boolean @default(true)

  @@index([state])
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  /// Markdown
  content     String   @db.Text
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
