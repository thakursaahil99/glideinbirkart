# PostgreSQL connection used by the Prisma CLI (migrate / seed / studio).
# Local default assumes a `postgres` superuser with password `postgres` and a database named glideinbir_kart.
# Production: use the pooled connection string from Neon / Supabase (append ?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glideinbir_kart?schema=public"
