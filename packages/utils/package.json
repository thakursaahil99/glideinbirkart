{
  "name": "@gk/utils",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic helpers: money, GST pricing engine, Indian validators, text utils",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@gk/config": "workspace:*",
    "eslint": "^9.39.0",
    "tsup": "latest",
    "typescript": "~5.9.3",
    "vitest": "latest"
  }
}
