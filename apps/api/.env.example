# ───────────────────────── Glideinbir Kart API ─────────────────────────
# Copy to `.env` and adjust. The API validates these with Zod on boot and refuses to start
# when a required value is missing or malformed.

# ── Runtime ──
NODE_ENV=development            # development | test | production
PORT=4000                       # HTTP port
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
API_PUBLIC_URL=http://localhost:4000   # Public base URL of this API (used for local upload URLs, invoice links)
WEB_URL=http://localhost:3000          # Public URL of the web app (links in emails, CORS)
CORS_ORIGINS=http://localhost:3000     # Comma-separated allow-list of browser origins (strict whitelist)

# ── PostgreSQL ──
# Dev: local Postgres. Prod: Neon / Supabase pooled URL (…?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glideinbir_kart?schema=public

# ── Redis ──
# Dev: local Redis / Memurai. Prod: Upstash (use the rediss:// URL with TLS)
REDIS_URL=redis://localhost:6379
WORKERS_ENABLED=true            # run BullMQ workers in this process (set false to run API only)

# ── Auth ──
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars   # signs 15-min access tokens
JWT_ACCESS_TTL_SECONDS=900      # access token lifetime
REFRESH_TOKEN_TTL_DAYS=30       # rotating refresh token lifetime
SESSION_SECRET=change-me-too-another-long-random-string-32-chars-min      # signs the `gk_session` cookie read by the web middleware (must equal web SESSION_SECRET)
COOKIE_SECURE=false             # true in production (HTTPS only cookies)
COOKIE_DOMAIN=                  # optional, e.g. .glideinbirkart.in

# ── Payments (Razorpay) ──
# Leave key id/secret empty in dev to use the built-in mock gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # set the same secret in Razorpay Dashboard → Webhooks
ORDER_PAYMENT_WINDOW_MINUTES=15 # unpaid online orders release reserved stock after this many minutes

# ── Media (Cloudinary). Empty → files are stored on local disk under ./uploads ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email. Priority: Resend → SMTP (Gmail app-password) → console logger ──
MAIL_FROM="Glideinbir Kart <no-reply@glideinbirkart.in>"
RESEND_API_KEY=
SMTP_HOST=                      # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Monitoring ──
SENTRY_DSN=
