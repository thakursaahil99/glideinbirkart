{
  "name": "@gk/api",
  "version": "1.0.0",
  "private": true,
  "description": "Glideinbir Kart REST API (NestJS + Prisma + Redis + BullMQ)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand --forceExit"
  },
  "dependencies": {
    "@gk/db": "workspace:*",
    "@gk/types": "workspace:*",
    "@gk/utils": "workspace:*",
    "@gk/validators": "workspace:*",
    "@nest-lab/throttler-storage-redis": "latest",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/node": "latest",
    "argon2": "latest",
    "bullmq": "^5.81.5",
    "cloudinary": "latest",
    "compression": "latest",
    "cookie-parser": "latest",
    "csv-parse": "latest",
    "helmet": "latest",
    "ioredis": "^5.11.1",
    "nodemailer": "latest",
    "pdfkit": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "pino-pretty": "latest",
    "razorpay": "latest",
    "reflect-metadata": "latest",
    "resend": "latest",
    "rxjs": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@gk/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/compression": "latest",
    "@types/cookie-parser": "latest",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "latest",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "latest",
    "@types/pdfkit": "latest",
    "@types/supertest": "latest",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "supertest": "latest",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3"
  }
