# ───────────────────────── Glideinbir Kart Web ─────────────────────────
# Copy to `.env.local`.

# Public URL of this site (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Next.js server proxies /api/v1/* and /uploads/* to (server-side only).
# Dev: the local NestJS API. Prod: your Render service URL, e.g. https://glideinbir-kart-api.onrender.com
API_URL=http://localhost:4000

# Origin that serves product/banner images (the API's API_PUBLIC_URL host) — allow-listed for next/image.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Must equal SESSION_SECRET in apps/api/.env — the route-protection proxy verifies the `gk_session` cookie with it.
SESSION_SECRET=dev-session-secret-glideinbir-kart-0123456789abcdef

# Optional: Sentry browser DSN
NEXT_PUBLIC_SENTRY_DSN=
