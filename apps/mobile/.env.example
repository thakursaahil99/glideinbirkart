# ───────────────────────── Glideinbir Kart Mobile ─────────────────────────
# Copy to `.env`. Variables prefixed EXPO_PUBLIC_ are embedded in the app bundle (never put secrets here).

# Base URL of the REST API. IMPORTANT: a phone cannot reach "localhost" — use your computer's LAN IP
# (e.g. http://192.168.1.7:4000/api/v1). Android emulator → http://10.0.2.2:4000/api/v1.
EXPO_PUBLIC_API_URL=http://192.168.1.7:4000/api/v1

# Public website URL (used for share links / deep links)
EXPO_PUBLIC_SITE_URL=https://glideinbirkart.in

# EAS project id for Expo push tokens (from `eas init`)
EXPO_PUBLIC_EAS_PROJECT_ID=
