{
  "expo": {
    "name": "Glideinbir Kart",
    "slug": "glideinbir-kart",
    "version": "1.0.0",
    "scheme": "glideinbirkart",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4338ca"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.glideinbirkart.app",
      "associatedDomains": ["applinks:glideinbirkart.in"]
    },
    "android": {
      "package": "in.glideinbirkart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4338ca"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "glideinbirkart.in",
              "pathPrefix": "/products/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4338ca",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#4338ca"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
